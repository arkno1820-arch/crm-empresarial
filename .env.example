# Cifra alergias, medicamentos, previsión médica y contacto de emergencia
# en la base de datos (Ley 21.719 - datos sensibles). Genera la tuya con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NUNCA la cambies ni la pierdas una vez que haya datos guardados.
FIELD_ENCRYPTION_KEY=

# Credenciales de TU único acceso de administrador al arrancar la plataforma.
# Cambia esto antes del primer "docker compose up". Una vez que inicies sesión,
# tú serás quien cree el resto de los perfiles desde el módulo "Usuarios".
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=CambiaEstaClave123

GATEWAY_PORT=8080
# Puerto HTTPS del gateway (certificado autofirmado, sin dominio propio).
GATEWAY_HTTPS_PORT=8443
