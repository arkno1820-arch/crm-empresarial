#!/bin/bash
# Volcado periodico de las bases del CRM hacia crm-core-b (replica pasiva).
# Generado por Ansible (rol pg_replica) - no editar a mano, se sobreescribe.
#
# PROMOCION a primario: MANUAL. Ver runbook en infra/ansible/README.md
# ("Que hacer si crm-core falla").
set -euo pipefail

SECONDARY_HOST="{{ pg_secondary_ip }}"
SECONDARY_USER="{{ ansible_user }}"
IDENTITY="/home/{{ ansible_user }}/.ssh/id_replica"
DBS="auth_db empleados_db calendario_db inventario_db reservas_db chat_db"

for db in $DBS; do
  docker exec crm_postgres pg_dump -U crm_user "$db" | \
    ssh -i "$IDENTITY" -o StrictHostKeyChecking=accept-new "${SECONDARY_USER}@${SECONDARY_HOST}" \
    "docker exec -i crm_postgres psql -U crm_user -d $db"
done

echo "[$(date -u +%FT%TZ)] replica_push OK -> ${SECONDARY_HOST}"
