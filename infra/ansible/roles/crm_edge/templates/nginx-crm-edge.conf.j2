# Los dos nucleos sirven la aplicacion (activa-activa, stateless): si uno falla, Nginx
# lo marca caido y usa el otro sin intervencion. La base de datos, en cambio, tiene un
# unico primario elegido por Patroni; cada nucleo llega a el a traves de HAProxy.
{% for m in microservicios %}
upstream crm_{{ m.nombre }} {
{% for n in core_nodes %}
    server {{ n.ip }}:{{ m.puerto }} max_fails=1 fail_timeout=30s;
{% endfor %}
}
{% endfor %}

server {
    listen 80;

    # Descarga de la CA privada (application/x-x509-ca-cert hace que Android
    # ofrezca instalarla directo al abrir esta URL desde el celular/tablet).
    location = /ca.crt {
        alias /usr/local/share/ca-certificates/crm-ca.crt;
        default_type application/x-x509-ca-cert;
    }

{% for m in microservicios %}
    location /api/{{ m.nombre }}/ {
        proxy_pass http://crm_{{ m.nombre }}/;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_connect_timeout 1s;
{% if m.nombre == 'chat' %}
        client_max_body_size 30M;
{% endif %}
    }
{% endfor %}

    root {{ repo_dest }}/frontend;
    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl;

    ssl_certificate     /etc/ssl/certs/crm-edge.crt;
    ssl_certificate_key /etc/ssl/private/crm-edge.key;

    location = /ca.crt {
        alias /usr/local/share/ca-certificates/crm-ca.crt;
        default_type application/x-x509-ca-cert;
    }

{% for m in microservicios %}
    location /api/{{ m.nombre }}/ {
        proxy_pass http://crm_{{ m.nombre }}/;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_connect_timeout 1s;
{% if m.nombre == 'chat' %}
        client_max_body_size 30M;
{% endif %}
    }
{% endfor %}

    root {{ repo_dest }}/frontend;
    location / {
        try_files $uri $uri/ /index.html;
    }
}
