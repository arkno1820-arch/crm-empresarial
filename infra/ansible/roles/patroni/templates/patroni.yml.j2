# Gestionado por Ansible (rol patroni). Contiene contrasenas: no versionar.
scope: {{ patroni_scope }}
namespace: {{ patroni_namespace }}
name: {{ patroni_name }}

restapi:
  listen: 0.0.0.0:{{ patroni_rest_port }}
  connect_address: {{ ansible_host }}:{{ patroni_rest_port }}

etcd:
  hosts: {{ etcd_endpoints }}

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    synchronous_mode: true
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 10
        max_replication_slots: 10
        wal_keep_size: 256MB
        wal_log_hints: "on"
  initdb:
    - encoding: UTF8
    - data-checksums

postgresql:
  listen: 0.0.0.0:{{ pg_port_directo }}
  connect_address: {{ ansible_host }}:{{ pg_port_directo }}
  data_dir: /var/lib/postgresql/{{ pg_version }}/patroni
  bin_dir: /usr/lib/postgresql/{{ pg_version }}/bin
  authentication:
    superuser:
      username: postgres
      password: "{{ lookup('password', '/home/cesar/.crm-secrets/pg_superuser length=24 chars=ascii_letters,digits') }}"
    replication:
      username: replicator
      password: "{{ lookup('password', '/home/cesar/.crm-secrets/pg_replicator length=24 chars=ascii_letters,digits') }}"
  parameters:
    unix_socket_directories: /var/run/postgresql
  # Patroni aplica ESTE pg_hba completo (sin las lineas "trust" que deja initdb):
  # solo el socket local es de confianza; por red todo exige contrasena (scram).
  pg_hba:
    - local all all trust
    - host all all 127.0.0.1/32 scram-sha-256
    - host replication replicator 10.10.10.0/24 scram-sha-256
    - host all all 10.10.10.0/24 scram-sha-256
    - host all all 172.16.0.0/12 scram-sha-256

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
