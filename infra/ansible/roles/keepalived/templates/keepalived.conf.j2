vrrp_instance CRM_EDGE {
    state {{ keepalived_state }}
    interface {{ keepalived_interface }}
    virtual_router_id 51
    priority {{ keepalived_priority }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass crmedgevrrp
    }
    virtual_ipaddress {
        {{ keepalived_vip }}
    }
}
